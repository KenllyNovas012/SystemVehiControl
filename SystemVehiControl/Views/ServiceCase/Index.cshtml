@model IEnumerable<SystemVehiControl.Models.ServiceCase>

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h2>Lista de Casos de Servicio</h2>
        <a href="@Url.Action("Create", "ServiceCase")" class="btn btn-info btn-sm">Nuevo Caso</a>
        <br /><br />
        <table id="servicecase_table" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Mecánico</th>
                    <th>Tipo Servicio</th>
                    <th>Prioridad</th>
                    <th>Fecha Entrada</th>
                    <th>Entrega Estimada</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var estados = new[] { "Abierto", "En proceso", "Cerrado", "En espera" };

                    <tr>
                        <td>@item.GetUser?.Name</td>
                        <td>@item.ServiceType?.Name</td>
                        <td>@item.Priority?.Level</td>
                        <td>@item.EntryDate.ToShortDateString()</td>
                        <td>@item.EstimatedDeliveryDate.ToShortDateString()</td>
                       
                        <td>
                            <select class="form-select status-select" data-id="@item.Id">
                                <option value="">-- Seleccione un estado --</option>
                                @foreach (var estado in estados)
                                {
                                    <option value="@estado" selected="@(estado == item.Status ? "selected" : null)">@estado</option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Edit", "ServiceCase", new { id = item.Id })" class="btn btn-primary btn-sm">Editar</a>
                                <form id="deleteForm-@item.Id" method="post" action="@Url.Action("Delete", "Vehicles", new { id = item.Id })">
                                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete(@item.Id)">Eliminar</button>
                                </form>
                                <a href="@Url.Action("Print", "ServiceCase", new { id = item.Id })"
                                   target="_blank"
                                   class="btn btn-success btn-sm">Imprimir Despacho</a>
                            </div>
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#servicecase_table').DataTable();
        });

        function confirmDelete(clientId) {
            Swal.fire({
                title: '¿Seguro que quieres eliminar este cliente?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${clientId}`).submit();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".status-select").forEach(function (select) {
                select.addEventListener("change", function () {
                    const id = this.dataset.id;
                    const newStatus = this.value;

                    // Mostrar un loader de SweetAlert2 mientras hace fetch (opcional)
                    Swal.fire({
                        title: 'Actualizando...',
                        text: 'Por favor espera...',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    fetch(`/ServiceCase/UpdateStatus`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ id: id, status: newStatus })
                    })
                        .then(response => {
                            Swal.close(); // Cierra el loader cuando la respuesta llega
                            if (response.ok) {
                                // ✔️ Mostrar alerta de éxito
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Estado actualizado',
                                    text: 'El estado se actualizó correctamente.',
                                    confirmButtonText: 'OK'
                                });
                            } else {
                                // ❌ Mostrar alerta de error
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: 'Hubo un error al actualizar el estado.',
                                    confirmButtonText: 'OK'
                                });
                            }
                        })
                        .catch(error => {
                            console.error("Error en la solicitud:", error);
                            Swal.close(); // Cierra el loader
                            // ❌ Mostrar alerta de error de conexión
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'No se pudo conectar con el servidor.',
                                confirmButtonText: 'OK'
                            });
                        });
                });
            });
        });
    </script>
}

