@model SystemVehiControl.Models.ServiceCase
@{
    var comentarios = ViewData["Comments"] as List<SystemVehiControl.Models.Comment>;
    bool esAdmin = false;
    if (ViewBag.EsAdmin != null)
    {
        esAdmin = (bool)ViewBag.EsAdmin;
    }

}
<div class="card">
    <form asp-action="Edit" method="post" class="form-horizontal">

        <div class="card-body">
            <h4 class="card-title">Editar Caso de Servicio</h4>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <!-- Columna izquierda -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="VehicleReceptionId">Recepción Vehículo</label>
                        <select asp-for="VehicleReceptionId" class="form-control" asp-items="@(ViewData["VehicleReceptions"] as SelectList)">
                            <option value="">-- Seleccione una recepción --</option>
                        </select>
                        <span asp-validation-for="VehicleReceptionId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ServiceTypeId">Tipo de Servicio</label>
                        <select asp-for="ServiceTypeId" class="form-control" asp-items="@(ViewData["ServiceTypes"] as SelectList)">
                            <option value="">-- Seleccione un tipo de servicio --</option>
                        </select>
                        <span asp-validation-for="ServiceTypeId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PriorityId">Prioridad</label>
                        <select asp-for="PriorityId" class="form-control" asp-items="@(ViewData["Priorities"] as SelectList)">
                            <option value="">-- Seleccione prioridad --</option>
                        </select>
                        <span asp-validation-for="PriorityId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EntryDate">Fecha de Entrada</label>
                        <input asp-for="EntryDate" type="date" class="form-control" />
                        <span asp-validation-for="EntryDate" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="EstimatedDeliveryDate">Fecha Estimada de Entrega</label>
                        <input asp-for="EstimatedDeliveryDate" type="date" class="form-control" />
                        <span asp-validation-for="EstimatedDeliveryDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Columna derecha -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="UserId">Mecánico</label>
                        <select asp-for="UserId" class="form-control" asp-items="@(ViewData["Users"] as SelectList)">
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Ingrese descripción del trabajo realizado"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Status">Estado</label>
                        <select asp-for="Status" class="form-control">
                            <option value="">-- Seleccione un estado --</option>
                            <option value="Abierto">Abierto</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Cerrado">Cerrado</option>
                            <option value="En espera">En espera</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CloseDate">Fecha de Cierre</label>
                        @if (esAdmin)
                        {
                            <input asp-for="CloseDate" type="date" class="form-control" />
                        }
                        else
                        {
                            <input asp-for="CloseDate" type="date" class="form-control" readonly />
                        }
                        <span asp-validation-for="CloseDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-top">
            <div class="card-body">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="@Url.Action("Index", "ServiceCase")" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </form>
    <hr />

    <div class="card-body">
        <h5>Agregar Comentario</h5>
        <form asp-action="AddComment" method="post">
            <input type="hidden" name="ServiceCaseId" value="@Model.Id" />
            <div class="col-md-6">
                <div class="form-group">
                    <label for="Text">Comentario</label>
                    <div class="input-group">
                        <textarea id="Text" name="Text" class="form-control" rows="3" placeholder="Escribe o habla tu comentario..."></textarea>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" onclick="startRecognition()">
                                🎤
                            </button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Agregar Comentario</button>
                </div>
            </div>
        </form>

    @if (comentarios != null && comentarios.Any())
    {
        <div class="mt-4">
            <h5>Comentarios</h5>
            <table class="table table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>ID</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comentario in comentarios)
                    {
                        <tr>
                            <td>@comentario.Id</td>
                            <td>@comentario.Text</td>
                            <td>@comentario.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">No hay comentarios para este caso.</p>
    }
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        let recognition;
        function startRecognition() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Tu navegador no soporta reconocimiento de voz.");
                return;
            }

            recognition = new SpeechRecognition();
            recognition.lang = 'es-ES';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            recognition.onstart = function () {
                console.log("Escuchando...");
            };

            recognition.onresult = function (event) {
                const texto = event.results[0][0].transcript;
                document.getElementById("Text").value += texto + " ";
            };

            recognition.onerror = function (event) {
                console.error("Error de reconocimiento:", event.error);
            };

            recognition.start();
        }
    </script>
}
