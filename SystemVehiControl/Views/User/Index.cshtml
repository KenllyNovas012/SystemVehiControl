@model IEnumerable<SystemVehiControl.Models.User>

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />


<div class="card">
    <div class="card-body">
        <h2>Lista de Usuarios</h2>
        <a href="@Url.Action("Create", "User")" class="btn btn-info btn-sm">Nuevo Usuario</a>
        <br /><br />
        <table id="user_table" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Rol</th>
                    <th>Nombre</th>
                    <th>Tipo Documento</th>
                    <th>Número Documento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Activo</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Role?.Name</td>
                        <td>@user.Name</td>
                        <td>@user.DocumentType</td>
                        <td>@user.DocumentNumber</td>
                        <td>@user.Phone</td>
                        <td>@user.Email</td>
                        <td>@(user.IsActive ? "Sí" : "No")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Edit", "User", new { id = user.UserId })" class="btn btn-primary btn-sm">Editar</a>
                                <form id="deleteForm-@user.UserId" method="post" action="@Url.Action("Delete", "User", new { id = user.UserId })">
                                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete(@user.UserId)">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#user_table').DataTable();
        });

        function confirmDelete(clientId) {
            Swal.fire({
                title: '¿Seguro que quieres eliminar este cliente?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${clientId}`).submit();
                }
            });
        }
    </script>
}