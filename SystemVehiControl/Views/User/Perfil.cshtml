@model SystemVehiControl.Dto.CrearDto

@{
    ViewData["Title"] = "Ver Perfil";
}

<div class="card">
    <div class="card-body">
    <form asp-action="Edit" method="post" class="form-horizontal">
        <div class="card-body">
            <h4 class="card-title">Ver Perfil</h4>

            <input type="hidden" asp-for="UserId" />

            <div class="form-group row" hidden>
                <label asp-for="RoleId" class="col-sm-3 text-end control-label col-form-label">Rol</label>
                <div class="col-sm-9">
                    <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-control">
                        <option value="">Seleccione un rol</option>
                    </select>
                    <span asp-validation-for="RoleId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Name" class="col-sm-3 text-end control-label col-form-label">Nombre</label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="DocumentType" class="col-sm-3 text-end control-label col-form-label">Tipo Documento</label>
                <div class="col-sm-9">
                    <input asp-for="DocumentType" class="form-control" />
                    <span asp-validation-for="DocumentType" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="DocumentNumber" class="col-sm-3 text-end control-label col-form-label">Número Documento</label>
                <div class="col-sm-9">
                    <input asp-for="DocumentNumber" class="form-control" />
                    <span asp-validation-for="DocumentNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Address" class="col-sm-3 text-end control-label col-form-label">Dirección</label>
                <div class="col-sm-9">
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Phone" class="col-sm-3 text-end control-label col-form-label">Teléfono</label>
                <div class="col-sm-9">
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Email" class="col-sm-3 text-end control-label col-form-label">Correo</label>
                <div class="col-sm-9">
                    <input asp-for="Email" class="form-control" readonly />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="IsActive" class="col-sm-3 text-end control-label col-form-label">Activo</label>
                <div class="col-sm-9">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>
            </div>

        </div>
       @*  <div class="border-top">
            <div class="card-body">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </div> *@
    </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}