@model SystemVehiControl.Models.Role

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="card">
    <form asp-action="Edit" method="post" class="form-horizontal">
        <div class="card-body">
            <h4 class="card-title">Editar Rol</h4>

            <input type="hidden" asp-for="RoleId" />

            <div class="form-group row">
                <label asp-for="Name" class="col-sm-3 text-end control-label col-form-label">Nombre</label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Description" class="col-sm-3 text-end control-label col-form-label">Descripción</label>
                <div class="col-sm-9">
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="IsActive" class="col-sm-3 text-end control-label col-form-label">Activo</label>
                <div class="col-sm-9">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                </div>
            </div>

        </div>
        <div class="border-top">
            <div class="card-body">
                <button type="submit" class="btn btn-primary">Guardar </button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}