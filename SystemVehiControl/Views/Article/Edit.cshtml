@model SystemVehiControl.Models.Article

<div class="card">
    <form asp-action="Edit" method="post" class="form-horizontal">
        <div class="card-body">
            <h4 class="card-title">Editar Artículo</h4>

            @* Campo oculto para el ID del artículo *@
            <input type="hidden" asp-for="ArticleId" />

            <div class="form-group row">
                <label asp-for="CategoryId" class="col-sm-3 text-end control-label col-form-label">Categoría</label>
                <div class="col-sm-9">
                    <select asp-for="CategoryId" class="form-control" asp-items="@(ViewData["CategoryId"] as SelectList)">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Code" class="col-sm-3 text-end control-label col-form-label">Código</label>
                <div class="col-sm-9">
                    <input asp-for="Code" class="form-control" placeholder="Ingrese código del artículo" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Name" class="col-sm-3 text-end control-label col-form-label">Nombre</label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" placeholder="Ingrese nombre del artículo" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="SalePrice" class="col-sm-3 text-end control-label col-form-label">Precio de Venta</label>
                <div class="col-sm-9">
                    <input asp-for="SalePrice" type="number" step="0.01" class="form-control" placeholder="Ingrese precio" />
                    <span asp-validation-for="SalePrice" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Stock" class="col-sm-3 text-end control-label col-form-label">Stock</label>
                <div class="col-sm-9">
                    <input asp-for="Stock" type="number" min="0" class="form-control" placeholder="Ingrese stock disponible" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="Description" class="col-sm-3 text-end control-label col-form-label">Descripción</label>
                <div class="col-sm-9">
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Ingrese descripción del artículo"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label asp-for="IsActive" class="col-sm-3 text-end control-label col-form-label">¿Activo?</label>
                <div class="col-sm-9">
                    <input asp-for="IsActive" class="form-check-input mt-2" type="checkbox" />
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>
            </div>

        </div>
        <div class="border-top">
            <div class="card-body">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a href="@Url.Action("Index", "Article")" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}
