@model IEnumerable<SystemVehiControl.Models.Article>

<link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/jquery.dataTables.min.css" />
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

<div class="card">
    <div class="card-body">
        <h2>Lista de Articulos</h2>
        <a href="@Url.Action("Create", "Article")" class="btn btn-info btn-sm">Nuevo Articulo</a>
        <br /><br />
        <table id="vehicle_table" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Categoria</th>
                    <th>Articulo</th>
                    <th>Codigo </th>
                    <th>Precio Venta </th>
                    <th>Stock </th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Article in Model)
                {
                    <tr>
                        <td>@Article.Category.Name</td>
                        <td>@Article.Name</td>
                        <td>@Article.Code</td>
                        <td>@Article.SalePrice</td>
                        <td>@Article.Stock</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a href="@Url.Action("Edit", "Article", new { id = Article.ArticleId })" class="btn btn-primary btn-sm">Editar</a>
                                <form id="deleteForm-@Article.ArticleId" method="post" action="@Url.Action("Delete", "Article", new { id = Article.ArticleId })">
                                    <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete(@Article.ArticleId)">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#vehicle_table').DataTable();
        });

        function confirmDelete(clientId) {
            Swal.fire({
                title: '¿Seguro que quieres eliminar este articulo?',
                text: "Esta acción no se puede deshacer.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById(`deleteForm-${clientId}`).submit();
                }
            });
        }
    </script>
}
