@model SystemVehiControl.Models.Client

<div class="card">
    <form asp-action="Crear" asp-controller="Person" method="post" class="form-horizontal">
        <div class="card-body">
            <h4 class="card-title">Información del Cliente</h4>

            <div class="form-group row">
                <label for="FullName" class="col-sm-3 text-end control-label col-form-label">Nombre Completo</label>
                <div class="col-sm-9">
                    <input asp-for="FullName" required class="form-control" placeholder="Ingrese el nombre completo" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label for="DocumentType" class="col-sm-3 text-end control-label col-form-label">Tipo Documento</label>
                <div class="col-sm-9">
                    <select asp-for="DocumentType" class="form-control" asp-items="@(new List<SelectListItem> {
                                                                                    new SelectListItem { Text = "Cédula", Value = "Cedula" },
                                                                                    new SelectListItem { Text = "Pasaporte", Value = "Pasaporte" },
                                                                                    new SelectListItem { Text = "Licencia", Value = "Licencia" }
                                                                                })">
                        <option value="">Seleccione tipo de documento</option>
                    </select>
                    <span asp-validation-for="DocumentType" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group row">
                <label for="IdentificationNumber" class="col-sm-3 text-end control-label col-form-label">Identificación</label>
                <div class="col-sm-9">
                    <input asp-for="IdentificationNumber" required class="form-control" placeholder="Ingrese número de identificación" />
                    <span asp-validation-for="IdentificationNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label for="MobileNumber" class="col-sm-3 text-end control-label col-form-label">Teléfono Móvil</label>
                <div class="col-sm-9">
                    <input asp-for="MobileNumber" id="MobileNumber" required class="form-control" placeholder="Ingrese teléfono móvil" />
                    <span asp-validation-for="MobileNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label for="Email" class="col-sm-3 text-end control-label col-form-label">Email</label>
                <div class="col-sm-9">
                    <input asp-for="Email" type="email" required class="form-control" placeholder="Ingrese correo electrónico" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group row">
                <label for="Address" class="col-sm-3 text-end control-label col-form-label">Dirección</label>
                <div class="col-sm-9">
                    <input asp-for="Address" required class="form-control" placeholder="Ingrese la dirección" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

        

        </div>
        <div class="border-top">
            <div class="card-body">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a href="@Url.Action("Index", "Person")" class="btn btn-secondary">Cancelar</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/inputmask/5.0.8/inputmask.min.js"></script>
    <script>
        // Esperar que el DOM esté listo (opcional)
        document.addEventListener("DOMContentLoaded", function () {
            Inputmask("999-999-9999").mask("#MobileNumber");
        });
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}